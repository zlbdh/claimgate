# Generate three independent standard-Base64 keys, each decoding to at least 32 bytes.
# Keep every key stable across restarts and never reuse one key for another purpose.
# Evidence, pickup-pass, candidate-handle, and database key-check master key.
CLAIMGATE_HMAC_KEY=
# Demo session signing key.
CLAIMGATE_SESSION_KEY=
# CSRF token signing key.
CLAIMGATE_CSRF_KEY=
# Absolute local SQLite file path; in-memory, relative, and network paths are rejected.
CLAIMGATE_DATABASE_PATH=
# Exact canonical HTTP(S) origin with no path, query, fragment, or trailing slash.
CLAIMGATE_APP_ORIGIN=
