[Unit]
Description=ClaimGate persistent ingress source gate
After=local-fs.target
ConditionPathIsDirectory=/opt/claimgate/current
ConditionPathIsDirectory=/opt/claimgate/runtime/current
ConditionPathExists=/etc/claimgate/ingress-gate.env

[Service]
Type=simple
User=claimgate-gate
Group=www-data
WorkingDirectory=/opt/claimgate/current
EnvironmentFile=/etc/claimgate/ingress-gate.env
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--max-old-space-size=48
ExecStartPre=/usr/bin/test -x /opt/claimgate/runtime/current/bin/node
ExecStartPre=/usr/bin/test -r /opt/claimgate/current/scripts/ingress-gate.mjs
ExecStart=/opt/claimgate/runtime/current/bin/node /opt/claimgate/current/scripts/ingress-gate.mjs
Restart=on-failure
RestartSec=2s
TimeoutStartSec=15s
TimeoutStopSec=10s
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native

RuntimeDirectory=claimgate-ingress-gate
RuntimeDirectoryMode=0750
StateDirectory=claimgate-ingress-gate
StateDirectoryMode=0700
ReadOnlyPaths=/opt/claimgate
ReadWritePaths=/run/claimgate-ingress-gate
ReadWritePaths=/var/lib/claimgate-ingress-gate

MemoryAccounting=true
MemoryHigh=64M
MemoryMax=96M
TasksMax=32
LimitNOFILE=256

StandardOutput=null
StandardError=journal
SyslogIdentifier=claimgate-ingress-gate

[Install]
WantedBy=multi-user.target
