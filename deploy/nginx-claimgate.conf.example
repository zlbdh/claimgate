# Replace the certificate-name placeholder only in a private deployment copy.
# Keep this as a dedicated vhost; do not merge it into another application's block.
map $http_origin $claimgate_origin_policy {
    default 0;
    ~^https://ds\.zlbdh\.top:8443$ 1;
}

map $http_sec_fetch_site $claimgate_fetch_policy {
    default 0;
    ~^same-origin$ 1;
}

server {
    listen 80;
    server_name ds.zlbdh.top;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/claimgate-acme;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 308 https://ds.zlbdh.top:8443$request_uri;
    }
}

server {
    listen 8443 ssl http2;
    server_name ds.zlbdh.top;

    ssl_certificate /etc/letsencrypt/live/REPLACE_WITH_CERTIFICATE_NAME/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/REPLACE_WITH_CERTIFICATE_NAME/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:CLAIMGATE_TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    server_tokens off;
    client_max_body_size 16k;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host ds.zlbdh.top:8443;
    proxy_set_header X-Forwarded-Host ds.zlbdh.top:8443;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Port 8443;
    proxy_set_header X-Real-IP $realip_remote_addr;
    proxy_set_header X-Forwarded-For $realip_remote_addr;
    proxy_cache off;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    proxy_redirect off;
    proxy_intercept_errors off;

    location = /api/demo/start {
        proxy_intercept_errors off;
        if ($request_method != POST) {
            return 405;
        }
        auth_request /_claimgate_demo_start_gate;
        auth_request_set $claimgate_gate_retry_after $upstream_http_retry_after;
        error_page 401 = @claimgate_demo_start_forbidden;
        error_page 403 = @claimgate_demo_start_limited;
        proxy_pass http://127.0.0.1:18121;
    }

    location = /_claimgate_demo_start_gate {
        internal;
        proxy_pass http://unix:/run/claimgate-ingress-gate/gate.sock:/check;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_pass_request_headers off;
        proxy_set_header Content-Length "";
        proxy_set_header Connection "";
        proxy_set_header Host claimgate-ingress-gate;
        proxy_set_header X-ClaimGate-Source $realip_remote_addr;
        proxy_set_header X-ClaimGate-Origin-Policy $claimgate_origin_policy;
        proxy_set_header X-ClaimGate-Fetch-Policy $claimgate_fetch_policy;
        proxy_cache off;
        proxy_connect_timeout 250ms;
        proxy_send_timeout 1s;
        proxy_read_timeout 1s;
    }

    location @claimgate_demo_start_limited {
        add_header Retry-After $claimgate_gate_retry_after always;
        add_header Cache-Control "private, no-store" always;
        return 429;
    }

    location @claimgate_demo_start_forbidden {
        add_header Cache-Control "private, no-store" always;
        return 403;
    }

    location / {
        proxy_pass http://127.0.0.1:18121;
    }
}
